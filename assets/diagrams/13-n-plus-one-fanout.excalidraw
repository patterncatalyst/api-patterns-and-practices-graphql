   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Highlighted: the same key fetched more than once in one request (V300A twice, SGSIN twice, CNSHA twice, DEHAM once per side, and the itinerary of every cargo twice).",
   "fontSize": 12,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Highlighted: the same key fetched more than once in one request (V300A twice, SGSIN twice, CNSHA twice, DEHAM once per side, and the itinerary of every cargo twice).",
   "lineHeight": 1.25,
   "baseline": 12
