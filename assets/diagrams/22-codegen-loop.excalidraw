   "roundness": null,
   "seed": 475383969,
   "versionNonce": 228835758,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Both stages run the same codegen against the same schema; a document that selects a field the contract lacks never becomes a type.",
   "fontSize": 12,
   "fontFamily": 1,
   "textAlign": "left",
