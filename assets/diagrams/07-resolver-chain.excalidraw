   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Each arrow into a resolver carries the parent value it receives. Each arrow to a source carries the key the resolver derived from it.",
   "fontSize": 12,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Each arrow into a resolver carries the parent value it receives. Each arrow to a source carries the key the resolver derived from it.",
