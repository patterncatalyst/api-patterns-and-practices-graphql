   "versionNonce": 259126107,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "and loadLocation and unloadLocation each have one, so getLocations runs twice (DEHAM+SGSIN+USNYC and CNSHA+DEHAM+NLRTM).",
   "fontSize": 12,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "and loadLocation and unloadLocation each have one, so getLocations runs twice (DEHAM+SGSIN+USNYC and CNSHA+DEHAM+NLRTM).",
   "lineHeight": 1.25,
   "baseline": 12
  },
