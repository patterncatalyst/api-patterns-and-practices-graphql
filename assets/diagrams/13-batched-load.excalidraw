   "roundness": null,
   "seed": 461270344,
   "versionNonce": 1873475782,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Quarkus makes 8 calls for the same query: Cargo.itinerary and Cargo.delivery each have a loader, so getItineraries runs twice,",
   "fontSize": 12,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Quarkus makes 8 calls for the same query: Cargo.itinerary and Cargo.delivery each have a loader, so getItineraries runs twice,",
   "lineHeight": 1.25,
   "baseline": 12
  },
  {
   "id": "t1768495747",
   "type": "text",
   "x": 40,
   "y": 388,
   "width": 792.0000000000001,
   "height": 15.0,
   "angle": 0,
   "strokeColor": "#555555",
   "backgroundColor": "transparent",
