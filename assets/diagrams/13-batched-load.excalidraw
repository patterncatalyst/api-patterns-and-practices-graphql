   "versionNonce": 155334541,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The four-key calls carry DEF456+STU678+VWX901+XYZ789: the cargos of the page, sorted, joined with +.",
   "fontSize": 12,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The four-key calls carry DEF456+STU678+VWX901+XYZ789: the cargos of the page, sorted, joined with +.",
   "lineHeight": 1.25,
   "baseline": 12
  },
  {
   "id": "t1378994245",
   "type": "text",
   "x": 40,
   "y": 370,
   "width": 831.6,
   "height": 15.0,
   "angle": 0,
   "strokeColor": "#555555",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
