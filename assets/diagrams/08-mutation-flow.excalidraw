   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Coercion belongs to the engine and runs before the resolver. Validation, lookup, append and re-read run in the resolver.",
   "fontSize": 12,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
