# Ch21 Real-time - the subscription test client, UBI 10, uv-managed, gql[websockets].
# Build (the build context is this directory):
#   docker build -f examples/21-real-time/client/Containerfile \
#     -t ch21-real-time-client examples/21-real-time/client
#
# The client runs on the compose network (profile `client`), so it reaches the
# servers by service name: ws://quarkus:8080/graphql and ws://python:8080/graphql.
#
# Pin: registry.access.redhat.com/ubi10/python-314-minimal:10.2-1791928506
# (the same image as the Python server).

FROM registry.access.redhat.com/ubi10/python-314-minimal:10.2-1791928506 AS build

USER 0
WORKDIR /app

RUN pip install --no-cache-dir uv==0.13.1

# --locked fails the build if uv.lock is out of date with pyproject.toml.
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev

FROM registry.access.redhat.com/ubi10/python-314-minimal:10.2-1791928506

WORKDIR /app

COPY --from=build --chown=1001:0 /app/.venv /app/.venv
COPY --chown=1001:0 subscribe.py ./
COPY --chown=1001:0 fixtures ./fixtures

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1

USER 1001

ENTRYPOINT ["python", "/app/subscribe.py"]
