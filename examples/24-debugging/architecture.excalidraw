   "link": null,
   "locked": false,
   "text": "verify.sh sends its own trace id with F1 and F2, reads the trace from Tempo and the log records from Loki, and switches the debug category on and off.",
   "fontSize": 12,
   "fontFamily": 1,
   "textAlign": "left",
