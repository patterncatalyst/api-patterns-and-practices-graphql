{
  "realm": "shipping",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 600,
  "registrationAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "shipper",
        "description": "A customer that books cargo"
      },
      {
        "name": "operator",
        "description": "Port staff that register handling events"
      }
    ]
  },
  "users": [
    {
      "username": "ana",
      "enabled": true,
      "emailVerified": true,
      "email": "ana@example.test",
      "firstName": "Ana",
      "lastName": "Fixture",
      "credentials": [
        {
          "type": "password",
          "value": "ana-fixture-pw",
          "temporary": false
        }
      ],
      "realmRoles": [
        "shipper"
      ],
      "requiredActions": [],
      "attributes": {
        "shipper": [
          "ACME"
        ]
      }
    },
    {
      "username": "bo",
      "enabled": true,
      "emailVerified": true,
      "email": "bo@example.test",
      "firstName": "Bo",
      "lastName": "Fixture",
      "credentials": [
        {
          "type": "password",
          "value": "bo-fixture-pw",
          "temporary": false
        }
      ],
      "realmRoles": [
        "shipper"
      ],
      "requiredActions": [],
      "attributes": {
        "shipper": [
          "GLOBEX"
        ]
      }
    },
    {
      "username": "ops",
      "enabled": true,
      "emailVerified": true,
      "email": "ops@example.test",
      "firstName": "Ops",
      "lastName": "Fixture",
      "credentials": [
        {
          "type": "password",
          "value": "ops-fixture-pw",
          "temporary": false
        }
      ],
      "realmRoles": [
        "operator"
      ],
      "requiredActions": []
    }
  ],
  "clients": [
    {
      "clientId": "tracking-cli",
      "description": "Lab only: public client with the password grant on, so a script can fetch a token with one request. Production uses the authorization code flow with PKCE.",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "defaultClientScopes": [
        "basic",
        "roles",
        "profile",
        "email"
      ],
      "protocolMappers": [
        {
          "name": "shipper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "shipper",
            "claim.name": "shipper",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "tracking-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "tracking-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "other-cli",
      "description": "Lab only: like tracking-cli without the audience mapper, so its tokens are valid but meant for another audience.",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "defaultClientScopes": [
        "basic",
        "roles",
        "profile",
        "email"
      ],
      "protocolMappers": [
        {
          "name": "shipper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "shipper",
            "claim.name": "shipper",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "short-cli",
      "description": "Lab only: like tracking-cli with a four-second access token lifetime, to show an expired token.",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "defaultClientScopes": [
        "basic",
        "roles",
        "profile",
        "email"
      ],
      "protocolMappers": [
        {
          "name": "shipper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "shipper",
            "claim.name": "shipper",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "tracking-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "tracking-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ],
      "attributes": {
        "access.token.lifespan": "4"
      }
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\": [{\"name\": \"username\", \"displayName\": \"${username}\", \"validations\": {\"length\": {\"min\": 3, \"max\": 255}, \"username-prohibited-characters\": {}, \"up-username-not-idn-homograph\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"email\", \"displayName\": \"${email}\", \"validations\": {\"email\": {}, \"length\": {\"max\": 255}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"firstName\", \"displayName\": \"${firstName}\", \"validations\": {\"length\": {\"max\": 255}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"lastName\", \"displayName\": \"${lastName}\", \"validations\": {\"length\": {\"max\": 255}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"shipper\", \"displayName\": \"Shipper\", \"permissions\": {\"view\": [\"admin\"], \"edit\": [\"admin\"]}, \"multivalued\": false}]}"
          ]
        }
      }
    ]
  }
}
