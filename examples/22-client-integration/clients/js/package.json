{
  "name": "ch22-js-client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Ch22 Client integration - Apollo Client with GraphQL Code Generator types, run headless in Node.",
  "engines": { "node": ">=24" },
  "scripts": {
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:check": "graphql-codegen --config codegen.fail.ts",
    "typecheck": "tsc --noEmit",
    "start": "node src/main.ts"
  },
  "dependencies": {
    "@apollo/client": "4.3.4",
    "graphql": "16.14.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "7.4.6",
    "@graphql-codegen/client-preset": "6.2.3",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
