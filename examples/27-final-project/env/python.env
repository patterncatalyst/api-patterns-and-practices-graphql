# The Python configuration contract of the tier, read by the OpenTelemetry SDK
# and by app/settings.py (the TRACKING_ prefix).
OTEL_EXPORTER_OTLP_ENDPOINT=http://lgtm:4317
OTEL_SERVICE_NAME=ch27-final-python
# Where the signing keys are read (the back channel) and the issuer the tokens carry
# (the address clients fetch them at). The same image runs in every tier; only these
# two values change.
TRACKING_OIDC_JWKS_URL=http://keycloak:8080/realms/shipping/protocol/openid-connect/certs
TRACKING_OIDC_ISSUER=http://localhost:8374/realms/shipping
