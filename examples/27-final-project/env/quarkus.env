# The Quarkus configuration contract of the tier. Quarkus maps each name to a
# property (QUARKUS_OTEL_SERVICE_NAME is quarkus.otel.service.name).
OTEL_EXPORTER_OTLP_ENDPOINT=http://lgtm:4317
QUARKUS_OTEL_SERVICE_NAME=ch27-final-quarkus
# Where the signing keys are read (the back channel) and the issuer the tokens carry
# (the address clients fetch them at). The same image runs in every tier; only these
# two values change.
QUARKUS_OIDC_AUTH_SERVER_URL=http://keycloak:8080/realms/shipping
QUARKUS_OIDC_TOKEN_ISSUER=http://localhost:8374/realms/shipping
# Bound the JVM so heap plus off-heap stay inside the container cap (see compose.yaml).
# Four Quarkus instances share a small CI runner with Keycloak and the LGTM backend;
# the default heap (80% of the cgroup) plus Netty/Vert.x direct memory can cross the
# cap under load, and the kernel then kills the container and compose revives it with
# fresh state. Keep the image's two default opts. The same bounds suit every instance.
JAVA_OPTS_APPEND=-Dquarkus.http.host=0.0.0.0 -Djava.util.logging.manager=org.jboss.logmanager.LogManager -Xms64m -Xmx384m -XX:MaxDirectMemorySize=128m -XX:MaxMetaspaceSize=160m
