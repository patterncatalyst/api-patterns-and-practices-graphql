# Ch23 Testing GraphQL APIs - Python, UBI 10, uv-managed, Strawberry on FastAPI.
# Build (the build context is this directory):
#   docker build -f examples/23-testing/python/Containerfile \
#     -t ch23-testing-python examples/23-testing/python
#
# The schema is built code-first from the decorated classes, so unlike the
# gRPC series no contract file is copied into the image.
#
# UBI 10 publishes only the -minimal Python image (no ubi10/python-314).
# Pin: registry.access.redhat.com/ubi10/python-314-minimal:10.2-1791928506
# Re-check with:
#   skopeo list-tags docker://registry.access.redhat.com/ubi10/python-314-minimal
# and confirm with `skopeo inspect`. Bump deliberately.

# -- Stage 1: Build ----------------------------------------------------------
FROM registry.access.redhat.com/ubi10/python-314-minimal:10.2-1791928506 AS build

# The image runs as UID 1001; the build stage needs root to write /app.
# Build at the same path the runtime uses: a venv is not relocatable, its
# console scripts carry the absolute interpreter path.
USER 0
WORKDIR /app

RUN pip install --no-cache-dir uv==0.13.1

# --locked fails the build if uv.lock is out of date with pyproject.toml.
# Dependencies first, in their own layer: a source-only change reuses it.
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev --no-install-project

COPY app ./app
RUN uv sync --locked --no-dev

# -- Test stage: the in-process suite -----------------------------------------
# `docker compose run python-test` builds this stage and runs pytest. The
# development group (pytest, httpx, asgi-lifespan, anyio) is installed here and
# only here. The client documents arrive as the `documents` build context.
# pytest writes junit.xml and the test run writes the exported schema to /out,
# a directory the caller mounts. The runtime stage below does not depend on
# this stage, so a normal image build neither installs the test tools nor runs
# the tests.
FROM build AS test
RUN uv sync --locked
COPY tests ./tests
COPY --from=documents . tests/documents/
ENV TRACKING_TEST_EXPORT_DIR=/out
# umask 0 leaves the reports deletable by the user who mounted /out.
CMD umask 0 && exec uv run --locked pytest -q --junitxml=/out/junit.xml

# -- Stage 2: Runtime --------------------------------------------------------
FROM registry.access.redhat.com/ubi10/python-314-minimal:10.2-1791928506

WORKDIR /app

COPY --from=build --chown=1001:0 /app/.venv /app/.venv
COPY --from=build --chown=1001:0 /app/app /app/app

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONPATH="/app" \
    PYTHONUNBUFFERED=1 \
    OTEL_SERVICE_NAME=ch23-testing-python \
    OTEL_TRACES_EXPORTER=otlp \
    OTEL_METRICS_EXPORTER=none \
    OTEL_LOGS_EXPORTER=none \
    OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317 \
    OTEL_PYTHON_LOGGING_AUTO_INSTRUMENTATION_ENABLED=false

EXPOSE 8080
USER 1001

# opentelemetry-instrument is a zero-code wrapper: it auto-instruments the
# FastAPI app and exports spans to OTEL_EXPORTER_OTLP_ENDPOINT. With no
# collector listening (the `observability` compose profile is off by default)
# the exporter only logs failed exports in the background.
ENTRYPOINT ["opentelemetry-instrument", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8080"]
